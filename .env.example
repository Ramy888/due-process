# Copy to .env and fill in. `npx -w server tsx ../scripts/gen-wallets.ts` generates every *_PRIVATE_KEY below
# (testnet wallets only, printed as addresses, keys written here). Never commit .env.

# --- wallets (Base Sepolia testnet only)
DESK_PRIVATE_KEY=            # deploys DeskLedger, receives x402 clearance fees, funds traders, signs CRE broadcasts
CHIEF_PRIVATE_KEY=           # the Desk Chief agent: EIP-712 approvals and refusals
HUMAN_APPROVER_PRIVATE_KEY=  # the human co-signer / appeals judge (held by the local server behind the UI buttons)
FROG_DEPLOYER_PRIVATE_KEY=   # deploys the staged $FROG scam token
TRADER_KOL_PRIVATE_KEY=
TRADER_WHALE_PRIVATE_KEY=
TRADER_NEWS_PRIVATE_KEY=
TRADER_MEME_PRIVATE_KEY=
TRADER_DIP_PRIVATE_KEY=

# --- desk server
DESK_API_TOKEN=              # bearer token for the private evidence API (Confidential HTTP); scripts/sync-cre-env.ts creates it
ANTHROPIC_ENV_FILE=          # path to a .env file holding ANTHROPIC_API_KEY (read for that one key only), or set ANTHROPIC_API_KEY
# PORT=8787
# AGENT_MODE=cache-first     # replay | live | cache-first; replay never calls the model (used for the video)
# AGENT_REPLAY_FILE=data/replay/agents.jsonl
# DESK_DB=data/runtime/desk.sqlite
# X402_FACILITATOR_URL=https://x402.org/facilitator
# X402_OFFLINE=1             # development only: verify x402 signatures locally, settle nothing (the UI shows a red banner)

# --- Chainlink CRE (the CLI reads its own secrets from workflows/.env, see scripts/sync-cre-env.ts)
# CRE_CLEARANCE_TARGET=local-simulation   # base-sepolia once DeskLedger is deployed
# CRE_DESK_TARGET=local-simulation        # base-sepolia once DeskLedger is deployed
# CRE_BROADCAST=1                          # send the report transactions for real
# CRE_BIN=cre
# CRE_TIMEOUT_MS=180000

# --- chain
# DEPLOYMENT=base-sepolia     # which deployments/<name>.json the server signs and records against
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# LEDGER_RPC_URL=             # overrides the RPC used to read DeskLedger
# TRADER_USDC=0.5             # test USDC the deploy script gives each trader
